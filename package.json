{
  "name": "communications",
  "private": true,
  "version": "0.29.0",
  "type": "module",
  "scripts": {
    "build": "vite build && vite build --config vite.delivery.config.ts && vite build --config vite.flow.config.ts && node ./scripts/install-assets.mjs",
    "build:dev": "vite build --mode development && vite build --config vite.delivery.config.ts --mode development && vite build --config vite.flow.config.ts --mode development && node ./scripts/install-assets.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:libresign": "playwright test tests/e2e/libresign-event.spec.mjs",
    "lint": "eslint src tests scripts vite*.ts vitest.config.ts playwright.config.mjs",
    "audit": "npm audit --audit-level=high",
    "test": "npm run test:unit",
    "test:coverage": "vitest run --coverage",
    "ts:check": "vue-tsc --noEmit",
    "check-types": "npm run ts:check",
    "lint:types": "vue-tsc --noEmit",
    "lint:styles": "stylelint \"src/**/*.{css,vue}\"",
    "stylelint": "stylelint \"src/**/*.{css,vue}\"",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@mdi/js": "7.4.47",
    "@nextcloud/l10n": "3.4.1",
    "@nextcloud/vue": "9.14.1",
    "@uiw/codemirror-theme-material": "4.25.12",
    "vue": "^3.5.18",
    "vue-codemirror6": "1.7.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nextcloud/stylelint-config": "3.2.1",
    "@playwright/test": "1.65.0",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "24.19.2",
    "@typescript-eslint/parser": "8.72.2",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/coverage-v8": "4.1.12",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.1",
    "globals": "17.14.0",
    "sass": "1.108.1",
    "stylelint": "17.16.0",
    "typescript": "6.0.3",
    "vite": "7.3.8",
    "vitest": "4.1.12",
    "vue-tsc": "3.3.13"
  },
  "engines": {
    "node": "^24.0.0",
    "npm": "^11.0.0"
  }
}
