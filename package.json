{
  "name": "communications",
  "private": true,
  "version": "0.29.0",
  "type": "module",
  "scripts": {
    "build": "vite build && vite build --config vite.delivery.config.js && vite build --config vite.flow.config.js && node ./scripts/install-assets.mjs",
    "build:dev": "vite build --mode development && vite build --config vite.delivery.config.js --mode development && vite build --config vite.flow.config.js --mode development && node ./scripts/install-assets.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:libresign": "playwright test tests/e2e/libresign-event.spec.mjs",
    "lint": "eslint src tests scripts vite*.js playwright.config.mjs",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@mdi/js": "7.4.47",
    "@nextcloud/l10n": "3.4.1",
    "@nextcloud/vue": "9.14.1",
    "@uiw/codemirror-theme-material": "4.25.12",
    "vue": "^3.5.18",
    "vue-codemirror6": "1.7.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@typescript-eslint/parser": "8.72.2",
    "@vitejs/plugin-vue": "^6.0.0",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.1",
    "globals": "17.14.0",
    "sass": "1.108.1",
    "vite": "7.3.8"
  },
  "engines": {
    "node": "^24.0.0",
    "npm": "^11.0.0"
  }
}
