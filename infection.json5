{
  "$schema": "https://raw.githubusercontent.com/infection/infection/0.35.10/resources/schema.json",
  "source": {
    "directories": ["lib/Service"]
  },
  "phpUnit": {
    "configDir": "."
  },
  "testFrameworkExtraArgs": "--testsuite=unit",
  "minMsi": 90,
  "minCoveredMsi": 90,
  "mutators": {
    "@default": true
  }
}
