<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
 <id>communications</id>
 <name>Comunicações</name>
 <summary>Publicações, avisos e mensagens em um só lugar no Nextcloud</summary>
 <description>Publicações institucionais, notificações e mensagens contextuais com uma caixa de entrada unificada.</description>
 <version>0.29.0</version>
 <licence>AGPL-3.0-or-later</licence>
 <author>LibreCode Coop</author>
 <namespace>Communications</namespace>
 <category>tools</category>
 <bugs>https://github.com/LibreCodeCoop/communications/issues</bugs>
 <repository>https://github.com/LibreCodeCoop/communications</repository>
 <dependencies><php min-version="8.3"/><nextcloud min-version="36" max-version="36"/></dependencies>
 <background-jobs>
  <job>OCA\Communications\BackgroundJob\CleanupJob</job>
  <job>OCA\Communications\BackgroundJob\BoardPublishJob</job>
 </background-jobs>
 <commands>
  <command>OCA\Communications\Command\Campaign</command>
  <command>OCA\Communications\Command\PublishDue</command>
 </commands>
 <activity>
  <settings><setting>OCA\Communications\Activity\BoardSetting</setting></settings>
  <providers><provider>OCA\Communications\Activity\BoardProvider</provider></providers>
 </activity>
</info>
