{
  "extends": "@vue/tsconfig/tsconfig.json",
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "src/**/*.d.ts",
    "tests/js/unit/**/*.ts",
    "vite*.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "node_modules",
    "vendor",
    "dist*",
    "css",
    "js"
  ],
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "paths": {"@/*": ["./src/*"]}
  },
  "vueCompilerOptions": {
    "target": 3
  }
}
