{
  "name": "librecode/communications",
  "description": "Nextcloud institutional publications and event-triggered communications",
  "type": "project",
  "license": "AGPL-3.0-or-later",
  "require": {
    "php": ">=8.3"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.59",
    "nextcloud/coding-standard": "^1.5",
    "nextcloud/ocp": "^35.0",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5",
    "symfony/console": "^7.4",
    "symfony/routing": "^7.4"
  },
  "autoload": {
    "psr-4": {
      "OCA\\Communications\\": "lib/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "OCA\\Communications\\Tests\\": "tests/php/"
    }
  },
  "scripts": {
    "lint": "find lib templates tests -type f -name '*.php' -print0 | xargs -0 -n1 php -l",
    "test": "phpunit --configuration phpunit.xml.dist",
    "analyse": "phpstan analyse --configuration phpstan.neon.dist --no-progress",
    "check": [
      "@lint",
      "@test",
      "@analyse"
    ],
    "cs:check": "php-cs-fixer fix --dry-run --diff --using-cache=no",
    "cs:fix": "php-cs-fixer fix --using-cache=no"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {},
    "platform": {
      "php": "8.3.0"
    }
  }
}
