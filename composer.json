{
  "name": "librecode/communications",
  "description": "Nextcloud institutional publications and event-triggered communications",
  "type": "project",
  "license": "AGPL-3.0-or-later",
  "require-dev": {
    "bamarni/composer-bin-plugin": "^1.9",
    "nextcloud/ocp": "dev-master"
  },
  "autoload": {
    "psr-4": {
      "OCA\\Communications\\": "lib/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "OCA\\Communications\\Tests\\": "tests/php/"
    }
  },
  "scripts": {
    "lint": "find lib templates tests -type f -name '*.php' -print0 | xargs -0 -n1 php -l",
    "test": "phpunit --configuration phpunit.xml.dist",
    "analyse": "@phpstan",
    "check": [
      "@lint",
      "@test",
      "@analyse"
    ],
    "cs:check": "php-cs-fixer fix --dry-run --diff --using-cache=no",
    "cs:fix": "php-cs-fixer fix --using-cache=no",
    "mutation:test": "infection lib/Service/CtaUrl.php --threads=2 --no-progress --no-interaction",
    "test:unit": "phpunit --configuration phpunit.xml.dist",
    "phpstan": "phpstan analyse --configuration phpstan.neon",
    "post-install-cmd": [
      "[ \"$COMPOSER_DEV_MODE\" -eq 0 ] || composer bin all install --ansi"
    ],
    "post-update-cmd": [
      "[ \"$COMPOSER_DEV_MODE\" -eq 0 ] || composer bin all update --ansi"
    ]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "bamarni/composer-bin-plugin": true
    },
    "platform": {
      "php": "8.3.0"
    }
  },
  "extra": {
    "bamarni-bin": {
      "bin-links": true,
      "forward-command": true
    }
  }
}
